# PayPal sandbox app credentials (Developer Dashboard > Apps & Credentials > Sandbox).
# The app needs the Invoicing feature enabled.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Sandbox only. The server refuses to start with any other host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox buyer account. If set, every invoice is addressed here instead of the parsed client email.
CLIENT_EMAIL=sandbox-buyer@example.com

# Primary AI provider: any OpenAI-compatible Chat Completions API (${AI_BASE_URL}/chat/completions)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your-groq-api-key
AI_MODEL=openai/gpt-oss-120b
# Optional display name for the UI label; defaults to Groq/OpenRouter or the host name
AI_PROVIDER=

# Optional fallback provider, used once when the primary returns 429, 5xx or times out (45 s)
AI2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI2_API_KEY=your-gemini-api-key
AI2_MODEL=gemini-3.5-flash-lite
AI2_PROVIDER=

# Set to "mock" to return labelled sample data without calling any provider (local development only)
AI_MODE=

PORT=3000
# 127.0.0.1 (default) accepts local connections only. Use 0.0.0.0 on a host such as Render.
HOST=
